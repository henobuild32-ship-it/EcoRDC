# ==========================================
# EcoRDC Environment Variables
# ==========================================
# Copy this file to .env and fill in your values

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require"

# Auth
ADMIN_SECRET_CODE=your_admin_secret_code
JWT_SECRET=your_jwt_secret_min_32_chars

# GeniusPay Production Keys
# Get from: https://geniuspay.ci
GENIUSPAY_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
GENIUSPAY_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx
GENIUSPAY_API_BASE=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_ENV=production
GENIUSPAY_WEBHOOK_SECRET=your_webhook_secret_for_hmac_signature

# Subscription & Registration Fees (FC = Congolese Francs)
VENDOR_REGISTRATION_FEE=10000
VENDOR_MONTHLY_SUBSCRIPTION=10000
