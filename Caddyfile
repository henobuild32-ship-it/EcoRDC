# ==========================================
# EcoRDC Domain Masking - Caddy Reverse Proxy
# ==========================================
# This Caddyfile routes *.ecordc traffic to Vercel
# while keeping the custom domain visible in the browser URL bar.
#
# SETUP:
# 1. Point *.ecordc DNS A record to your VPS IP
# 2. Install Caddy on the VPS: sudo apt install caddy
# 3. Copy this file to /etc/caddy/Caddyfile
# 4. Restart Caddy: sudo systemctl restart caddy
#
# For wildcard subdomains (shop.ecordc):
# - Point *.ecordc DNS to your VPS IP
# - Caddy will handle all subdomains automatically
# ==========================================

# Wildcard domain for all shop subdomains
*.ecordc {
    reverse_proxy https://eco-rdc.vercel.app {
        header_up Host eco-rdc.vercel.app
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Handle CORS for API calls
    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
    }

    # Compress responses
    encode gzip zstd

    # Cache static assets
    @static path /_next/static/* /favicon.ico
    header @static Cache-Control "public, max-age=31536000, immutable"
}

# Main domain
ecordc {
    reverse_proxy https://eco-rdc.vercel.app {
        header_up Host eco-rdc.vercel.app
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    encode gzip zstd
}
